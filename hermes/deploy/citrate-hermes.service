# Hermes daemon — hardened, unprivileged systemd unit (ADR-H6).
#
# Install as a --user service on the DGX:
#   mkdir -p ~/.config/systemd/user
#   cp hermes/deploy/citrate-hermes.service ~/.config/systemd/user/
#   # edit WorkingDirectory + EnvironmentFile paths below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now citrate-hermes
#   journalctl --user -u citrate-hermes -f
#
# Runs as the invoking (non-root) user. Because Hermes has shell access via capsules,
# the hardening below contains the blast radius of a compromise to an unprivileged
# sandbox, not the machine (T5/T10).

[Unit]
Description=Citrate Hermes operator agent (HERMES-L)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Absolute paths — edit to your checkout.
WorkingDirectory=%h/Projects/Citrate-Labs/citrate-agent-runtime
EnvironmentFile=%h/Projects/Citrate-Labs/citrate-agent-runtime/.env.hermes
ExecStart=%h/Projects/Citrate-Labs/citrate-agent-runtime/target/release/hermesd
Restart=on-failure
RestartSec=5

# --- hardening (ADR-H6) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# The one writable path Hermes needs (workspace for agent-code/capsules). Narrow this.
ReadWritePaths=%h/Projects/Citrate-Labs/citrate-agent-runtime
PrivateTmp=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# NOTE: ProtectKernelTunables/Modules/ControlGroups are omitted — they require capability
# manipulation a --user manager can't perform (exit 218/CAPABILITIES). To enable them, run
# Hermes as a SYSTEM service under a dedicated unprivileged user instead.
# NOTE: capability-dropping (CapabilityBoundingSet=/AmbientCapabilities=) is intentionally
# omitted — a --user service already runs unprivileged with no capabilities, and the user
# manager is not permitted to set the bounding set (it fails with EPERM). NoNewPrivileges
# above already blocks any escalation.

[Install]
WantedBy=default.target
